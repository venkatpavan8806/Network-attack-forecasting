# Copy to .env.local for local development, or set these in Vercel ->
# Project -> Settings -> Environment Variables. All three are public values
# (they end up in the browser bundle) -- never put a service-role key here.

# Render backend URL (no trailing slash). Leave unset locally: /api is
# proxied to http://127.0.0.1:8000 by vite.config.ts.
VITE_API_URL=https://nadf-backend.onrender.com

# Supabase -> Project Settings -> Data API / API Keys.
# Leave both unset for local dev mode (no login, one workspace per browser).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
