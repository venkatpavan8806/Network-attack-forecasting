# Set these in Vercel -> Project -> Settings -> Environment Variables
# (or copy to frontend/.env.local for local development).

# Backend URL on Render, no trailing slash. Leave unset locally (/api is proxied to :8000).
VITE_API_URL=https://your-backend.onrender.com

# Supabase -> Project Settings -> Data API (Project URL) and API Keys (anon / publishable key)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
