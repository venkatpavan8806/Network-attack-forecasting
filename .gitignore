# Generated data, trained models, and runtime state -- all reproducible via
# `python -m app.train` (see README). The live-capture SQLite log in
# particular can contain real captured network metadata (real local IPs,
# ports, timestamps) from live testing and must never be committed.
backend/data/*.csv
backend/data/*.json
backend/data/*.sqlite3
backend/models_store/*.pt
backend/models_store/*.joblib
backend/models_store/*.json

