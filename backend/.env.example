# Backend environment (Render -> Service -> Environment). Locally, leave all
# unset to use SQLite + dev auth (each browser = its own workspace).

# Supabase -> Connect -> Session pooler (IPv4-compatible; Render cannot reach the IPv6-only direct host)
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-DB-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Supabase project URL -- enables verification of user logins (JWKS)
SUPABASE_URL=https://your-project-ref.supabase.co

# Only for projects on the legacy HS256 JWT secret
SUPABASE_JWT_SECRET=

# Vercel site URL(s), comma separated
CORS_ORIGINS=https://your-site.vercel.app

# Public URL of this backend (pre-filled into the downloadable capture agent)
PUBLIC_API_URL=https://nadf-backend.onrender.com
